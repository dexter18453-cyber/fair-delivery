# Local pilot only. Set DEMO_MODE=false on public deployments.
DEMO_MODE=true
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Used when DEMO_MODE=false. Set unique, long values in Render Environment.
SHOP_ACCESS_CODE=change-this-shop-code
RIDER_ACCESS_CODE=change-this-rider-code
ADMIN_ACCESS_CODE=change-this-admin-code

# Optional AI assistant. Keep the key only on the server; never in HTML/GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_REQUESTS_PER_10_MIN=10
